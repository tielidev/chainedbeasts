---
/**
 * AdsterraSlot — an Adsterra ad unit mounted in a sandboxed iframe.
 *
 * Adsterra banner scripts all configure themselves through the shared
 * `window.atOptions` global, so two units inlined on one page clobber each
 * other (slot B renders with slot A's config). Every unit therefore lives in
 * its own static html file under `public/ads/` — `<name>.html`, holding
 * exactly the snippet from the Adsterra dashboard (Ad Units → GET CODE) —
 * and this component mounts it in an iframe. The sandbox omits
 * `allow-top-navigation` (some mobile creatives try to navigate the whole
 * page away) — but with `allow-scripts` + `allow-same-origin` both present
 * (creatives need them to render), the sandbox is layout containment and
 * navigation friction, NOT a hard security boundary against a malicious
 * creative; true isolation would take a separate origin. Full rationale:
 * docs/ads.md 「广告位怎么挂（独立文件 + iframe 隔离）」.
 *
 * Gated on PUBLIC_ADSTERRA_SLOT_<NAME> (name upper-cased, hyphens become
 * underscores — `sidebar-300x250` → `PUBLIC_ADSTERRA_SLOT_SIDEBAR_300X250`).
 * Empty = nothing rendered, the same env contract as the AdSense slots. The
 * html file itself is not build inputs — also create it in `public/ads/` or
 * the iframe 404s as an empty box.
 *
 * Consent-gated like GA/AdSense: when the cookie banner is active (its own
 * render condition in BaseLayout includes enabled Adsterra slots, GA or AdSense
 * set), the iframe mounts WITHOUT src (data-src holds the real URL) and a
 * small ES2018 inline script promotes data-src → src only after the visitor
 * has consented — either a stored 'accepted' in CookieConsent's localStorage
 * flag, or the `aw:consent-accepted` event it dispatches on accept. Declined
 * or unchosen → the unit never loads, matching the banner's promise that
 * ads wait for consent. No enabled tracking or advertising → banner never renders → the
 * iframe loads directly (out-of-box zero-consent behavior unchanged).
 */
interface Props {
  /** Slot name = html filename stem under public/ads/ (e.g. `sidebar-300x250`). */
  name: string;
  /** Creative width in px — keep in sync with the unit's Adsterra size. */
  width: number;
  /** Creative height in px — keep in sync with the unit's Adsterra size. */
  height: number;
  /** Set to `false` to hide the "Advertisement" label (labels default on). */
  label?: boolean;
  /**
   * Hide below md (fixed-size creatives clip inside a narrower iframe —
   * a 728 creative in a ~375px viewport shows ~47% and an inner scrollbar).
   * Pair a hideOnMobile banner with the responsive native-banner, which
   * fills any width. Same pattern as StickyBanner's `hidden md:block`.
   */
  hideOnMobile?: boolean;
}

import { currentSharedStrings } from '~/lib/shared-ui';

const { name, width, height, label = true, hideOnMobile = false } = Astro.props;
const envKey = `PUBLIC_ADSTERRA_SLOT_${name.replace(/-/g, '_').toUpperCase()}`;
const show = !!import.meta.env[envKey];
// Same env condition under which BaseLayout renders CookieConsent — when
// either is set the banner (and its consent promise) is live on every page.
const consentBannerActive = !!(
  (import.meta.env.PUBLIC_GA_ID as string | undefined) ||
  (import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined) ||
  Object.entries(import.meta.env).some(([key,value]) => key.startsWith('PUBLIC_ADSTERRA_SLOT_') && !!value)
);
const iframeSrc = `/ads/${name}.html`;
const sharedStrings = currentSharedStrings(Astro.currentLocale);
const adLabel = sharedStrings.adLabel ?? 'Advertisement';
---
{
  show && (
    <>
      <div class="ad-size-container" data-await-consent={consentBannerActive ? '1' : undefined}>
      <div
        class:list={[
          'my-8 flex-col items-center justify-center',
          hideOnMobile ? 'hidden md:flex' : 'flex',
          hideOnMobile && 'ad-wide',
        ]}
      >
        {label && (
          <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">{adLabel}</span>
        )}
        <iframe
          data-ad-unit={name}
          src={consentBannerActive ? undefined : iframeSrc}
          data-src={consentBannerActive ? iframeSrc : undefined}
          data-adsterra-defer={consentBannerActive ? '1' : undefined}
          style={`width:100%;max-width:${width}px;height:${height}px;border:0`}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
          title={adLabel}
        />
      </div>
      </div>
      {consentBannerActive && (
        <script is:inline>
          /* ES2018 only (no optional chaining / nullish coalescing / optional
             catch binding) — runs untranspiled in the HTML, old webviews parse
             it. Consent-gated deferred load: promotes data-src → src on every
             pending Adsterra iframe once the visitor has consented. Declined
             or unchosen → never loads (same contract as __awLoadTrackers for
             GA/AdSense). Idempotent: each slot ships one copy of this script;
             only iframes still carrying data-adsterra-defer are touched.
             Event + storage key mirror src/lib/shared-ui.ts (inline scripts
             can't import; tests/consent.test.ts pins the duplicates). */
          (function () {
            var CONSENT_KEY = 'aw-cookie-consent';
            var CONSENT_EVENT = 'aw:consent-accepted';
            var granted = false;
            var activate = function (event) {
              if (event && event.type === CONSENT_EVENT) granted = true;
              var consent = null;
              try { consent = localStorage.getItem(CONSENT_KEY); } catch (e) { /* wait */ }
              if (consent === 'accepted') granted = true;
              if (!granted) return;
              var pending = document.querySelectorAll('iframe[data-adsterra-defer]');
              for (var i = 0; i < pending.length; i++) {
                var frame = pending[i];
                // A desktop creative hidden by a media query must not load on phones.
                if (!frame.getClientRects().length) continue;
                var src = frame.getAttribute('data-src');
                if (src) {
                  frame.src = src;
                }
                frame.removeAttribute('data-adsterra-defer');
                frame.removeAttribute('data-src');
                var placement = frame.closest('.ad-size-container');
                if (placement) placement.removeAttribute('data-await-consent');
              }
            };
            var wire = function () {
              window.addEventListener('resize', activate);
              var unitFrames = document.querySelectorAll('iframe[data-ad-unit]');
              for (var j = 0; j < unitFrames.length; j++) {
                (function (unitFrame) {
                  if (unitFrame.hasAttribute('data-state-wired')) return;
                  unitFrame.setAttribute('data-state-wired', '1');
                  window.addEventListener('message', function (event) {
                    if (event.origin !== location.origin || event.source !== unitFrame.contentWindow) return;
                    var state = event.data;
                    if (!state || state.type !== 'wiki-ad-state' || state.unit !== unitFrame.getAttribute('data-ad-unit') || typeof state.filled !== 'boolean') return;
                    var container = unitFrame.closest('.ad-size-container');
                    if (!container) return;
                    if (state.filled) container.removeAttribute('data-empty');
                    else container.setAttribute('data-empty', '1');
                  });
                })(unitFrames[j]);
              }
              var native = document.querySelector('iframe[data-ad-unit="native-banner"]');
              if (native && !native.hasAttribute('data-resize-wired')) {
                native.setAttribute('data-resize-wired', '1');
                window.addEventListener('message', function (event) {
                  if (event.origin !== location.origin || event.source !== native.contentWindow) return;
                  var data = event.data;
                  if (!data || data.type !== 'wiki-native-height' || typeof data.height !== 'number') return;
                  if (data.height >= 80 && data.height <= 5000) native.style.height = Math.ceil(data.height) + 'px';
                });
              }
              var stored = null;
              try {
                stored = localStorage.getItem(CONSENT_KEY);
              } catch (e) {
                /* storage unavailable — treat as no consent yet */
              }
              if (stored === 'accepted') {
                activate();
                return;
              }
              document.addEventListener(CONSENT_EVENT, activate);
            };
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', wire);
            } else {
              wire();
            }
          })();
        </script>
      )}
    </>
  )
}

<style>
  .ad-size-container { container-type: inline-size; }
  .ad-size-container[data-empty], .ad-size-container[data-await-consent] { height: 0; overflow: hidden; visibility: hidden; }
  @container (max-width: 727px) {
    .ad-wide { display: none; }
  }
</style>
