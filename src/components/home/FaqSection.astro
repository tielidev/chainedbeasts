---
/**
 * FaqSection — renders the FAQ accordion from locale JSON `home.faq`.
 *
 * Reused on the dedicated /faq page (and could be dropped back onto the
 * homepage in the future if desired). Pure CSS <details> accordion with a
 * tiny inline script to sync aria-expanded.
 */
import { Icon } from 'astro-icon/components';

interface FaqItem {
  question: string;
  answer: string;
  /** Optional link to the full guide behind this answer. */
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  items: FaqItem[];
  /** 'h2' when embedded in a page that already owns the H1 (homepage). */
  headingLevel?: 'h1' | 'h2';
  /** Label for per-item `href` links. */
  moreLabel?: string;
}
const { title, description, items = [], headingLevel = 'h1', moreLabel = 'Read more' } = Astro.props;
const Heading = headingLevel;
---

<section class="section">
  <Heading class="text-3xl font-extrabold tracking-tight md:text-4xl">{title}</Heading>
  {description && <p class="mt-2 text-muted-foreground">{description}</p>}
  <div class="mt-8 space-y-2" data-faq-group>
    {
      items.map((item: FaqItem) => (
        <details class="group rounded-md border bg-card">
          <summary
            class="flex cursor-pointer list-none items-center justify-between p-4 font-medium"
            aria-expanded="false"
          >
            {item.question}
            <Icon name="lucide:chevron-down" class="h-4 w-4 transition group-open:rotate-180" />
          </summary>
          <div class="px-4 pb-4 text-sm text-muted-foreground">
            {item.answer}
            {item.href && (
              <a href={item.href} class="ml-1 inline-flex items-center gap-1 text-nav hover:underline">
                {moreLabel}
                <Icon name="lucide:arrow-right" class="h-3 w-3" />
              </a>
            )}
          </div>
        </details>
      ))
    }
  </div>
</section>

<script is:inline>
  // Sync aria-expanded on FAQ summaries when details toggle.
  // ES2018 only — untranspiled inline script, parsed by old webviews.
  document.querySelectorAll('[data-faq-group] details').forEach((d) => {
    const sync = () => {
      const summary = d.querySelector('summary');
      if (summary) summary.setAttribute('aria-expanded', d.open ? 'true' : 'false');
    };
    sync();
    d.addEventListener('toggle', sync);
  });
</script>
